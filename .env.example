# Postgres-verbinding. In docker-compose wijst dit naar de db-service.
DATABASE_URL=postgres://gerechter:gerechter@localhost:5432/gerechter

# Publieke basis-URL waarop de app bereikbaar is (zonder slash aan het eind).
# Wordt gebruikt voor uitnodigings- en herstellinks en als OAuth-resource voor /mcp.
PUBLIC_BASE_URL=http://localhost:3000

# Geheim voor sessies en tokens, minstens 32 tekens. Genereer met: openssl rand -base64 32
BETTER_AUTH_SECRET=

# E-mailadres van de platformbeheerder. Alleen dit adres kan via /setup het eerste account aanmaken.
ADMIN_EMAIL=

# Poort waarop de app luistert.
PORT=3000

# Alleen voor docker-compose: wachtwoord van de Postgres-gebruiker.
POSTGRES_PASSWORD=gerechter
