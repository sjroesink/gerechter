# Postgres-verbinding. In docker-compose wijst dit naar de db-service.
DATABASE_URL=postgres://gerechter:gerechter@localhost:5432/gerechter

# Publieke basis-URL waarop de app bereikbaar is (zonder slash aan het eind).
# Wordt gebruikt voor uitnodigings- en herstellinks en als OAuth-resource voor /mcp.
PUBLIC_BASE_URL=http://localhost:3000

# Geheim voor sessies en tokens, minstens 32 tekens. Genereer met: openssl rand -base64 32
BETTER_AUTH_SECRET=

# E-mailadres van de platformbeheerder. Alleen dit adres kan via /setup het eerste account aanmaken.
ADMIN_EMAIL=

# Poort waarop de app luistert.
PORT=3000

# Alleen voor docker-compose: wachtwoord van de Postgres-gebruiker.
POSTGRES_PASSWORD=gerechter

# Alleen voor docker-compose: poorten op de host voor de app en de ontwikkelverbinding met Postgres.
APP_PORT=3000
DB_PORT=5432

# Alleen voor docker-compose: map voor alle blijvende gegevens (op Unraid bijvoorbeeld /mnt/user/appdata/gerechter).
DATA_DIR=./data

# Optionele experimentele AH-sidecar. Laat beide leeg om AH uit te schakelen.
# Voor pnpm dev met de compose-sidecar: http://127.0.0.1:3001
AH_SIDECAR_URL=
# Minstens 32 tekens; moet overeenkomen met de sidecar. Bewaar bij de AH-databack-up.
AH_SIDECAR_SECRET=
# Alleen voor de optionele AH-compose-override: loopback-hostpoort en gebruiker/groep van het datavolume.
# AH_SIDECAR_PORT=3001
# AH_UID=1000
# AH_GID=1000
